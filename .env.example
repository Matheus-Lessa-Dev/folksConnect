POSTGRES_DB=folks_connect
POSTGRES_USER=folks_connect
POSTGRES_PASSWORD=folks_connect_dev
POSTGRES_PORT=5432
BACKEND_PORT=8081
FRONTEND_PORT=8080

# Bootstrap exclusivo de desenvolvimento. Para produção: APP_ENV=production e DEV_SEED=false.
APP_ENV=development
DEV_SEED=true
DEV_ADMIN_EMAIL=admin@folks.local
DEV_ADMIN_PASSWORD=FolksDev!2026
CORS_ORIGINS=http://localhost:8080

# Recuperação de senha: configure um servidor SMTP real.
# Sem SMTP_HOST/SMTP_FROM, a rota responde 503 explicitamente.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_ALLOW_INSECURE=false
